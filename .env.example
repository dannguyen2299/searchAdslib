# --- Meta Ad Library API ---
# Access token tied to a Facebook account that has completed identity
# confirmation at https://www.facebook.com/ID (required by Meta before the
# ads_archive endpoint returns political/social-issue ad data).
# See README.md "Meta App setup" for how to obtain this. https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN= 

# App ID/Secret are only needed if you generate a long-lived token yourself
# (see README). The running service only ever uses META_ACCESS_TOKEN.
META_APP_ID=
META_APP_SECRET=

META_GRAPH_API_VERSION=v21.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# Default search parameters (can be overridden per-request)
META_AD_LIBRARY_COUNTRY=VN

# Hard ceiling on how many ads a single search will fetch across all pages.
META_AD_LIBRARY_MAX_RESULTS=100

# Seconds to cache a (keyword, country, status, ad_type) search result before
# re-querying Meta.
META_AD_LIBRARY_CACHE_TTL=3600

# HTTP client behaviour
META_AD_LIBRARY_REQUEST_TIMEOUT_SECONDS=15
META_AD_LIBRARY_MAX_RETRIES=3

# --- Database ---
POSTGRES_USER=adslib
POSTGRES_PASSWORD=adslib
POSTGRES_DB=adslib
DATABASE_URL=postgresql+psycopg2://adslib:adslib@db:5432/adslib

# --- App ---
LOG_LEVEL=INFO
